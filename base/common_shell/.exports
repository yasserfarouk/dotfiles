# NEC work directory
export NEC="$HOME/Library/Mobile Documents/com~apple~CloudDocs/yasser/business/NEC"

export PATH="$PATH:$HOME/.local/bin"
export PATH="$HOME/.poetry/bin:$PATH"
# export PATH="$HOME/.pyenv/bin:$PATH"
# export PATH="$PYENV_ROOT/bin:$PATH"
export PATH="/usr/local/sbin:$PATH"
export PATH="$PATH:/usr/local/mysql/bin"
export PATH="$PATH:$HOME/.composer/bin"
export PATH=$HOME/bin:$HOME/sbin:$HOME/bin-this:$PATH
export PATH="$PATH:."
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$PATH:$HOME/.composer/vendor/bin"
if [ -d "$HOME/.cargo/bin" ] ; then
    export PATH="$HOME/.cargo/bin:$PATH"
fi

if [ -f "$HOME/.exports.local" ] ; then
    source  "$HOME/.exports.local" 
fi
if [ -d "$HOME/usr/local/bin" ] ; then
    export PATH="$HOME/usr/local/bin:$PATH"
fi
export PATH="$HOME/.poetry/bin:$PATH"

# NVM (Node Version Manager)
export NVM_DIR="$HOME/.nvm"

# OpenCode CLI
if [ -d "$HOME/.opencode/bin" ] ; then
    export PATH="$HOME/.opencode/bin:$PATH"
fi

# save python cache files to a specific folder
PYTHONPYCACHEPREFIX="$HOME/.pycode"

# Setting fd as the default source for fzf
export FZF_DEFAULT_COMMAND='fd --type f'

# To apply the command to CTRL-T as well
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

export TERMINAL_DARK=1
# Only set xterm-kitty when actually running inside kitty
[[ "$TERM_PROGRAM" == "kitty" ]] && export TERM="xterm-kitty"
export _Z_DATA="$HOME/.z-data"


# Linuxbrew (user install)
if [ -d "$HOME/.linuxbrew/bin" ] ; then
    export PATH="$HOME/.linuxbrew/bin:$PATH"
fi

# Linuxbrew (system install - common on WSL/Linux)
if [ -d "/home/linuxbrew/.linuxbrew/bin" ] ; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

# Homebrew on macOS (Apple Silicon)
if [ -d /opt/homebrew/bin ] ; then
    export PATH="/opt/homebrew/bin:$PATH"
    export PATH="/opt/homebrew/sbin:$PATH"
fi

# Ensure $HOME/bin is in PATH (should be early for user overrides)
if [ -d "$HOME/bin" ] ; then
    export PATH="$HOME/bin:$PATH"
fi
# add uv path
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"


export _Z_DATA="$HOME/.z-data"
export LANGUAGE="en_US.UTF-8"
export LANG="en_US.UTF-8"
export LC_CTYPE="en_US.UTF-8"
export LC_NUMERIC="en_US.UTF-8"
export LC_TIME="en_US.UTF-8"
export LC_COLLATE="en_US.UTF-8"
export LC_MONETARY="en_US.UTF-8"
export LC_MESSAGES="en_US.UTF-8"
export LC_PAPER="en_US.UTF-8"
export LC_NAME="en_US.UTF-8"
export LC_ADDRESS="en_US.UTF-8"
export LC_TELEPHONE="en_US.UTF-8"
export LC_MEASUREMENT="en_US.UTF-8"
export LC_IDENTIFICATIO="en_US.UTFUTF"
export LC_ALL="en_US.UTF-8"
export EDITOR="nvim"
export VISUA="nvim"
export VISUAL="nvim"
export HISTSIZE=1000000
export HISTFILESIZE=1000000000
export SAVEHIST=10000


# for lldb which should be installed using brew
#  export LDFLAGS="-L/usr/local/opt/llvm/lib"
# export CPPFLAGS="-I/usr/local/opt/llvm/include"
export LDFLAGS="-L/usr/local/opt/libffi/lib"
export CPPFLAGS="-I/usr/local/opt/libffi/include"

export FZF_DEFAULT_OPTS='--height 40% --reverse --border --ansi'
export FZF_DEFAULT_COMMAND='fd --type file --follow  --color=always --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"

export KEYTIMEOUT=1
export TERMINAL_DARK=1
# [[ $TMUX = "" ]] && export TERM="xterm-kitty"
[[ $TMUX != "" ]] && export TERM="screen-256color"
export CLICOLOR=1
export EDITOR=nvim
export _Z_DATA="$HOME/.z-data"
export NVIM_PYTHON_LOG_FILE=/tmp/log
export NVIM_PYTHON_LOG_LEVEL=ERROR
export ZLE_RPROMPT_INDENT=0
export BULLETTRAIN_TIME_SHOW=false
export BULLETTRAIN_STATUS_SHOW=false
export BULLETTRAIN_PROMPT_ADD_NEWLINE=false
export DISABLE_AUTO_TITLE=true
export EVENT_NOKQUEUE=1
export VSCODE_TSJS=1

# deno assuming it is installed from its website

if [ -d "$HOME/.deno/bin" ] ; then
	export DENO_INSTALL="$HOME/.deno"
	export PATH="$DENO_INSTALL/bin:$PATH"
fi
# Tell zsh where it can find the history file.
# This is the default as suggested by the zsh wizard.
export HISTFILE=~/.z_history
# The maximum number of history entries to keep.
export SAVEHIST=100000
# The maximum number of history entries to keep alive in one session,
# typically the same as SAVEHIST.
export HISTSIZE=100000

# uv manages Python versions and virtual environments
# No PYENV_ROOT needed with uv


export ENABLE_UV=true
export ENABLE_CONDA=false

# set python cache folder for .pyc files:
#   https://stackoverflow.com/a/57415054
case "${OSTYPE}" in
    darwin*)
        folder="${HOME}/Library/Caches/Python"
        if [[ ! -d "${folder}" ]]; then mkdir -p "${folder}"; fi
        export PYTHONPYCACHEPREFIX="${folder}"
        ;;
    linux-*)
        folder="${HOME}/.cache/Python"
        if [[ ! -d "${folder}" ]]; then mkdir -p "${folder}"; fi
        export PYTHONPYCACHEPREFIX="${folder}"
        ;;
    *)
        printf "WARNING: unsupported operating system '%s'; "`
        `'not setting PYTHONPYCACHEPREFIX' "${OSTYPE}" >&2
        return 1
        ;;
esac

export PATH="/Users/yasser/.gem/ruby/2.7.0/bin:$PATH"
# System-ruby (2.6) user gems, used by the Jekyll site at code/sites/yasser
# (jekyll 3.9.3 + jekyll-scholar). Only export when the dir is present.
if [ -d "$HOME/.gem/ruby/2.6.0" ] ; then
	export GEM_HOME="$HOME/.gem/ruby/2.6.0"
	export GEM_PATH="$HOME/.gem/ruby/2.6.0"
	export PATH="$HOME/.gem/ruby/2.6.0/bin:$PATH"
fi
if [ -d "$HOME/bin/nvim/bin" ] ; then
	export PATH="$HOME/bin/nvim/bin:$PATH"
fi

# add current path
export PATH=".:$PATH"

# Convert markdown to PDF with pandoc
mdpdf() {
    if [[ -z "$1" ]]; then
        echo "Usage: mdpdf <filename.md>"
        return 1
    fi
    local filepath="$1"
    local dir="$(dirname "$filepath")"
    local basename="$(basename "$filepath")"
    local output="${filepath%.*}.pdf"
    pandoc "$filepath" -s \
        --pdf-engine=xelatex \
        --variable mainfont="Palatino" \
        --variable sansfont="Helvetica" \
        --variable monofont="Menlo" \
        --variable fontsize=10pt \
        --variable version=2.0 \
        --resource-path="$dir" \
        -F mermaid-filter \
        --filter pandoc-latex-admonition \
        --citeproc \
        --toc \
        --toc-depth=2 \
        -V geometry:margin=2cm \
        -V colorlinks=true \
        -V linkcolor=blue \
        -V urlcolor=blue \
        -V toccolor=blue \
        -o "$output"
}
source "$HOME/.sdkman/bin/sdkman-init.sh"

# Python TLS: trust the macOS System keychain, not just certifi
#
# The corporate root CA on this machine lives in the macOS System keychain, and
# Python ships its own trust store, so Python could not verify ANY certificate
# ("CERTIFICATE_VERIFY_FAILED: unable to get local issuer certificate") while
# curl worked fine. That is what broke every live-LLM path -- and it surfaces
# unhelpfully: litellm reports it as a bare "InternalServerError: Connection
# error", with nothing about certificates in the message.
#
# The bundle is the OS's own public roots (/etc/ssl/cert.pem) plus the System
# keychain's certs. Deliberately NOT SystemRootCertificates.keychain: one cert
# in it has Basic Constraints not marked critical, and OpenSSL then rejects the
# whole bundle ("Basic Constraints of CA cert not marked critical").
#
# Built on first use and cached. To refresh after a corporate root rotates:
#   rm ~/.config/ca/macos-system-roots.pem
if [ "$(uname -s)" = "Darwin" ]; then
  MACOS_CA_BUNDLE="$HOME/.config/ca/macos-system-roots.pem"
  if [ ! -s "$MACOS_CA_BUNDLE" ] && [ -f /etc/ssl/cert.pem ] && command -v security >/dev/null 2>&1; then
    mkdir -p "$(dirname "$MACOS_CA_BUNDLE")"
    # Write via a temp file and only publish a complete bundle: a partial one
    # (public roots missing) would break TLS harder than the default store.
    if { cat /etc/ssl/cert.pem && security find-certificate -a -p /Library/Keychains/System.keychain; } > "$MACOS_CA_BUNDLE.tmp" 2>/dev/null; then
      mv "$MACOS_CA_BUNDLE.tmp" "$MACOS_CA_BUNDLE"
    else
      rm -f "$MACOS_CA_BUNDLE.tmp"
    fi
  fi
  if [ -s "$MACOS_CA_BUNDLE" ]; then
    export SSL_CERT_FILE="$MACOS_CA_BUNDLE"
    export REQUESTS_CA_BUNDLE="$MACOS_CA_BUNDLE"
  fi
fi
