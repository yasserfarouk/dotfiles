#!/usr/bin/env bash
# New workmux worktree (own tmux session + default agent) for the current repo, from a tmux popup (Alt-a).
#   name            create it (or reopen an existing one) and switch to its session
#   name prompt...  create it in the background with the agent started on "prompt..." (stay here);
#                   if it already runs, the prompt is sent to its agent instead
# Put /agent/ anywhere in the line to use a non-default agent, e.g. "myfeature /codex/ fix the bug"
# or "/codex/ myfeature"; the token is stripped out and the rest is the name (+ prompt). Without it
# the default agent is used. Usage: wm-new [agent|pick]  (prefix-A passes "pick" to fzf-pick first).
agent=${1:-}
# Agents the /agent/ token (and the pick menu) accept, default first.
agents=(claude codex opencode pi gemini)
fail() { printf '\n%s\n[enter to close]' "$*"; read -r _; exit 1; }
# workmux's own switch-client has no -c and can move another attached client, so it always runs with
# --background and we switch the popup's client ($WM_CLIENT, set by the tmux binding) ourselves.
goto() {
  local p s
  p=$(workmux path "$1") || return 1
  s=$(tmux list-sessions -F '#{session_path}	#{session_name}' | awk -F'\t' -v p="$p" '$1 == p {print $2; exit}')
  [ -n "$s" ] && tmux switch-client ${WM_CLIENT:+-c "$WM_CLIENT"} -t "=$s"
}

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "Not in a git repo: $PWD"
if [ "$agent" = pick ]; then
  agent=$(for a in "${agents[@]}"; do command -v "$a" >/dev/null && echo "$a"; done |
    fzf --reverse --height=100% --prompt 'agent> ') || exit 0
fi

printf 'New worktree in %s%s\n' "${root/#$HOME/~}" "${agent:+  [$agent]}"
read -r -e -p 'name [/agent/] [prompt]: ' line || exit 0
# A /agent/ token anywhere in the line (only known agents) picks the agent and is stripped out;
# an explicit pick (prefix-A) still wins. Then split the rest into name (first word) + prompt.
agents_re=$(IFS='|'; echo "${agents[*]}")
if [[ $line =~ (^|[[:space:]])/(${agents_re})/([[:space:]]|$) ]]; then
  [ -n "$agent" ] || agent=${BASH_REMATCH[2]}
  tok=/${BASH_REMATCH[2]}/
  line=${line//"$tok"/ }
fi
read -r name prompt <<<"$line"
# kebab-case, keep "/" so feature/x style branches still work
slug=$(printf %s "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._/-]+/-/g; s/^-+|-+$//g')
[ -n "$slug" ] || exit 0
# The worktree (folder, handle and session) is <repo>-<name>, as the workmux wrapper names it;
# a worktree from the old <repo>/.worktrees/<name> layout keeps its bare name.
project=$(basename "$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")")
handle=${slug//\//-}
[[ $handle == "$project"-* ]] || handle=$project-$handle
wlist=$(workmux list --json)
jq -e --arg h "$slug" 'any(.[]; .handle == $h)' <<<"$wlist" >/dev/null && handle=$slug
exists=$(jq -e --arg h "$handle" 'any(.[]; .handle == $h)' <<<"$wlist" >/dev/null && echo 1)
open=$(jq -e --arg h "$handle" 'any(.[]; .handle == $h and .is_open)' <<<"$wlist" >/dev/null && echo 1)
# --open-if-exists reopens an existing worktree with the agent it was created with, so a
# non-default /agent/ only takes effect on a brand-new worktree; say so instead of silently
# reopening the old (usually claude) session.
[ -n "$agent" ] && [ -n "$exists" ] &&
  tmux display-message "worktree '$handle' already exists — keeping its agent (/$agent/ only applies to a new worktree)"
add=(workmux add "$slug" --name "$handle" --open-if-exists --background --session ${agent:+--agent "$agent"})

if [ -z "$prompt" ]; then
  "${add[@]}" >/dev/null || fail "workmux add $slug failed"
  goto "$handle"
elif [ -n "$open" ]; then
  workmux send "$handle" "$prompt" || fail "workmux send $handle failed"
  tmux display-message "sent prompt to $handle"
else
  "${add[@]}" --prompt "$prompt" >/dev/null || fail "workmux add $slug failed"
  tmux display-message "started $handle in the background${agent:+  [$agent]}"
fi
