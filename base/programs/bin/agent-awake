#!/usr/bin/env bash
# Keep the Mac awake while any coding agent is running: every minute, if `workmux status --all`
# reports an agent (claude/codex/opencode/pi, any repo, worktree or not) as working or waiting
# (on a permission prompt / question), hold a 90 s idle-sleep assertion (caffeinate -i).
# Closing the lid always sleeps: while the lid is closed it holds nothing, and if the Mac is still
# fully awake (clamshell mode on an external display, another app's hold) it runs pmset sleepnow.
# Claude Code holds its own caffeinate while it works; this also covers the other agents and the
# time an agent waits for an answer.
# Usage: agent-awake [run]               loop forever (what launchd runs)
#        agent-awake check               exit 0 if an agent is running now (lists them)
#        agent-awake install | uninstall | status
# Env:   AGENT_AWAKE_STATUSES (default "working waiting")
#        AGENT_AWAKE_DONE_SECS (default 7200): an agent that finished a turn ("done", waiting for
#        your next prompt, e.g. from your phone) still counts for this long after it finished
set -euo pipefail
label=com.yasser.agent-awake
plist=$HOME/Library/LaunchAgents/$label.plist
log=$HOME/Library/Logs/agent-awake.log
statuses=${AGENT_AWAKE_STATUSES:-working waiting}
done_secs=${AGENT_AWAKE_DONE_SECS:-7200}
die() { echo "agent-awake: $*" >&2; exit 1; }

# launchd's PATH lacks homebrew (workmux needs tmux) and its C locale makes tmux replace the
# separators in workmux's pane queries with "_"
export PATH=/opt/homebrew/bin:/usr/local/bin:$PATH LANG=${LANG:-en_US.UTF-8}
case $LANG in *UTF-8* | *utf8*) ;; *) export LANG=en_US.UTF-8 ;; esac
export LC_ALL=$LANG

# prints "status<TAB>session" for each running agent; exit 1 if there is none, 2 if workmux
# itself failed (the reason goes to the log, with a timestamp)
running() {
  local out err rc=0
  err=$(mktemp)
  out=$(workmux status --all --json 2>"$err") || { sleep 2; out=$(workmux status --all --json 2>"$err") || rc=$?; }
  if [ "$rc" = 0 ]; then
    printf '%s' "$out" | /usr/bin/python3 -c '
import json, sys
want = sys.argv[1].split()
try:
    agents = json.load(sys.stdin).get("agents", [])
except ValueError:
    sys.exit(2)
grace = int(sys.argv[2])  # a finished agent waits for you (e.g. on your phone) for this long
hits = [a for a in agents if a.get("status") in want
        or (a.get("status") == "done" and a.get("elapsed_secs", grace) < grace)]
for a in hits:
    print(a["status"], a.get("session") or a.get("worktree"), sep="\t")
sys.exit(0 if hits else 1)
' "$statuses" "$done_secs" || rc=$?
  fi
  [ "$rc" -gt 1 ] && echo "$(date '+%F %T') workmux status failed (rc $rc): $(head -c 300 "$err")" >&2
  rm -f "$err"
  return "$rc"
}

lid_closed() { ioreg -r -k AppleClamshellState -d 1 | grep -q '"AppleClamshellState" = Yes'; }
# full wake has Graphics; the short dark wakes (Power Nap, network) of a sleeping Mac don't
full_wake() { pmset -g systemstate | grep -q 'Capabilities are:.*Graphics'; }

# Lid closed = sleep, whatever is running: drop our holds and, if the Mac is still fully awake
# (clamshell mode on an external display, or another app holding it awake), put it to sleep.
lid_guard() {
  lid_closed || return 1
  pkill -g "$$" -x caffeinate 2>/dev/null || true
  if full_wake; then
    echo "$(date '+%F %T') lid closed while awake: sleeping now"
    pmset sleepnow >/dev/null || true
  fi
  return 0
}

# Overlapping timed assertions instead of one long-lived caffeinate: nothing to track or kill,
# and the machine can sleep at most ~90 s after the last agent stops or this loop dies.
# The lid is checked every 5 s, the agents every 60 s.
run() {
  local t=0
  while :; do
    if lid_guard; then t=0; sleep 5; continue; fi
    if [ "$t" -le 0 ]; then
      rc=0
      running >/dev/null || rc=$?
      # 2 = could not tell: stay awake if a tmux server (so agents) exists rather than sleep blindly
      if [ "$rc" = 0 ] || { [ "$rc" = 2 ] && pgrep -qx tmux; }; then caffeinate -i -t 90 & fi
      t=60
    fi
    sleep 5
    t=$((t - 5))
  done
}

install() {
  # the script's real path, not ~/bin: install.sh runs before setup.sh stows ~/bin
  local self
  self=$(/usr/bin/python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0")
  mkdir -p "${plist%/*}" "${log%/*}"
  cat >"$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>$self</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>$log</string>
  <key>StandardErrorPath</key><string>$log</string>
</dict></plist>
EOF
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$plist"
  echo "agent-awake: keeping the Mac awake while agents run (log $log)"
}

uninstall() {
  launchctl bootout "gui/$(id -u)/$label" 2>/dev/null || true
  rm -f "$plist"
  echo "agent-awake: removed"
}

status() {
  if [ -f "$plist" ]; then
    echo "launchd: $plist"
    launchctl print "gui/$(id -u)/$label" 2>/dev/null | grep -E '^\t(state|pid) ' | sed 's/^\t/  /' || echo "  (not loaded)"
  else
    echo "launchd: not installed (agent-awake install)"
  fi
  echo "agents counted as running ($statuses):"
  running | sed 's/^/  /' || echo "  none"
  # ours are in the launchd loop's process group (it leads one); the others are Claude Code's own
  local loop n=0 pid
  loop=$(launchctl print "gui/$(id -u)/$label" 2>/dev/null | awk '/^\tpid = /{print $3}')
  for pid in $(pgrep caffeinate); do
    [ -n "$loop" ] && [ "$(ps -o pgid= -p "$pid" | tr -d ' ')" = "$loop" ] && n=$((n + 1))
  done
  echo "keep-awake holds: $n from agent-awake, $(($(pgrep caffeinate | wc -l) - n)) from other tools"
  [ -s "$log" ] && { echo "last log lines ($log):"; tail -n 5 "$log"; }
  return 0
}

case ${1:-run} in
  run) run ;;
  check) running ;;
  install) install ;;
  uninstall) uninstall ;;
  status) status ;;
  -h|--help|help) sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command: $1 (run|check|install|uninstall|status)" ;;
esac
