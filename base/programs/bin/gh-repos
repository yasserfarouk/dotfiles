#!/usr/bin/env python3
"""Every repository of every account `gh` is logged in to, on every host (github.com and the NEC GHE.com
tenant): the accounts' own repos, the ones they collaborate on and those of their organizations.

Accounts come from `gh auth status --json hosts`; each is queried with its own token (`gh auth token -h HOST
-u LOGIN`, passed only in the environment of the `gh api` call, never stored) and labelled by its current login
from the API (gh's local name goes stale after a rename), except the GHE.com account, labelled `yassernec`.
The list is cached in ~/Library/Caches/gh-repos.json and refreshed in the background when older than 6 h.

Usage: gh-repos [list]          full_name<TAB>label<TAB>url, from the cache (refreshes it first if missing)
       gh-repos refresh         refetch now
       gh-repos --alfred QUERY  Alfred Script Filter JSON (alfred-kitty `repo`): ↩ open in the browser,
                                ⌘ copy the clone URL (github.com: ssh with the account's
                                ~/.ssh/config alias; GHE.com: https), ⌥ copy the web URL
"""
import json, os, subprocess, sys, time

os.environ["PATH"] = os.environ.get("PATH", "/usr/bin:/bin") + ":/opt/homebrew/bin:/usr/local/bin"
CACHE = os.path.expanduser("~/Library/Caches/gh-repos.json")
LOCK = CACHE + ".lock"
MAX_AGE = 6 * 3600
BIN = os.path.dirname(os.path.realpath(__file__))
# account labels (the GHE.com EMU login is generated) and the ~/.ssh/config Host alias of each account's key
LABELS = {("nec-corporation-emu.ghe.com", "ymohammad-253f3ddf"): "yassernec"}
SSH_ALIAS = {"yassernec": "yassernec", "yassernec-personal": "yassernec-personal", "yasserfarouk": "yf"}


def gh_api(host, token, path):
    env = dict(os.environ, GH_TOKEN=token, GH_HOST=host)
    env.pop("GITHUB_TOKEN", None)
    out = subprocess.run(["gh", "api", "--hostname", host, "--paginate", "--slurp", path],
                         env=env, capture_output=True, text=True, timeout=120)
    if out.returncode != 0:
        raise RuntimeError(f"{host} {path}: {out.stderr.strip()}")
    pages = json.loads(out.stdout)
    return [x for page in pages for x in (page if isinstance(page, list) else [page])]


def fetch():
    status = json.loads(subprocess.run(["gh", "auth", "status", "--json", "hosts"],
                                       capture_output=True, text=True).stdout or "{}")
    repos, errors = {}, []
    for host, accounts in status.get("hosts", {}).items():
        for acc in accounts:
            if acc.get("state") != "success":
                continue
            token = subprocess.run(["gh", "auth", "token", "-h", host, "-u", acc["login"]],
                                   capture_output=True, text=True).stdout.strip()
            if not token:
                continue
            try:
                login = gh_api(host, token, "user")[0]["login"]
                label = LABELS.get((host, login), login)
                found = gh_api(host, token, "user/repos?per_page=100&affiliation=owner,collaborator,organization_member")
                # user/repos can miss org repos visible as "internal" on EMU tenants: add each org's list
                for org in gh_api(host, token, "user/orgs?per_page=100"):
                    found += gh_api(host, token, f"orgs/{org['login']}/repos?per_page=100")
            except Exception as e:  # one failing account must not hide the others
                errors.append(str(e))
                continue
            for r in found:
                key = f"{host}/{r['full_name']}"
                item = repos.setdefault(key, {
                    "host": host, "full_name": r["full_name"], "url": r["html_url"], "ssh": r["ssh_url"],
                    "description": r.get("description") or "", "visibility": r.get("visibility") or "",
                    "archived": r.get("archived", False), "fork": r.get("fork", False),
                    "pushed_at": r.get("pushed_at") or "", "labels": []})
                if label not in item["labels"]:
                    item["labels"].append(label)
    items = sorted(repos.values(), key=lambda r: r["pushed_at"], reverse=True)
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"time": time.time(), "repos": items, "errors": errors}, f)
    os.replace(tmp, CACHE)
    return items, errors


def refreshing():
    try:
        return time.time() - os.path.getmtime(LOCK) < 300
    except OSError:
        return False


def refresh_in_background():
    if refreshing():
        return
    open(LOCK, "w").close()
    subprocess.Popen(["/bin/sh", "-c", f'"$0" refresh >/dev/null 2>&1; rm -f "{LOCK}"', os.path.realpath(__file__)],
                     start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load():
    try:
        with open(CACHE) as f:
            data = json.load(f)
    except (OSError, ValueError):
        return None
    if time.time() - data.get("time", 0) > MAX_AGE:
        refresh_in_background()
    return data


def clone_url(r):
    # GHE.com: https (gh's credential helper; ssh to the tenant is refused). github.com: git@<ssh alias>:owner/repo.git,
    # so the account's key is used (see ~/.ssh/config)
    if r["host"] != "github.com":
        return r["url"] + ".git"
    alias = next((SSH_ALIAS[l] for l in r["labels"] if l in SSH_ALIAS), None)
    return f"git@{alias}:{r['full_name']}.git" if alias else r["ssh"]


def alfred(query):
    data = load()
    if data is None:
        refresh_in_background()
        out = {"rerun": 1, "items": [{"title": "Fetching repositories of all gh accounts…", "valid": False,
                                      "subtitle": "github.com + nec-corporation-emu.ghe.com; takes a few seconds"}]}
    else:
        items = []
        for r in data["repos"]:
            flags = [f for f, on in (("archived", r["archived"]), ("fork", r["fork"])) if on]
            sub = " · ".join(x for x in [",".join(r["labels"]), r["visibility"], *flags, r["description"]] if x)
            if r["host"] != "github.com":
                sub = "GHE · " + sub
            items.append({"title": r["full_name"], "subtitle": sub, "arg": r["url"], "uid": r["url"],
                          "match": " ".join([r["full_name"], *r["labels"], r["description"]]),
                          "quicklookurl": r["url"], "variables": {"act": "open"},
                          "text": {"copy": r["url"], "largetype": r["full_name"]},
                          "mods": {"cmd": {"arg": clone_url(r), "subtitle": f"Copy {clone_url(r)}", "variables": {"act": "copy"}},
                                   "alt": {"arg": r["url"], "subtitle": f"Copy {r['url']}", "variables": {"act": "copy"}}}})
        if data.get("errors"):
            items.append({"title": "Some accounts failed: re-login with gh auth login", "valid": False,
                          "subtitle": "; ".join(data["errors"])[:300], "match": "error failed login"})
        items.append({"title": "Refresh the repository list", "subtitle": "gh-repos refresh (in the background)",
                      "arg": "", "variables": {"act": "refresh"}, "match": "refresh reload update"})
        out = {"items": items}
        if refreshing():
            out["rerun"] = 1
    res = subprocess.run([os.path.join(BIN, "alfred-fuzzy"), query], input=json.dumps(out),
                         capture_output=True, text=True)
    print(res.stdout if res.returncode == 0 else json.dumps(out))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "list"
    if cmd == "refresh":
        items, errors = fetch()
        print(f"{len(items)} repositories", file=sys.stderr)
        for e in errors:
            print("error:", e, file=sys.stderr)
    elif cmd == "--alfred":
        alfred(sys.argv[2] if len(sys.argv) > 2 else "")
    elif cmd == "--refresh-bg":
        refresh_in_background()
    elif cmd == "list":
        data = load()
        repos = data["repos"] if data else fetch()[0]
        for r in repos:
            print(f"{r['full_name']}\t{','.join(r['labels'])}\t{r['url']}")
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main()
