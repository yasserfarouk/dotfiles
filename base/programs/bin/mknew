#!/usr/bin/env bash
# Start a new piece of work in its usual place and open it in its tmux session running claude (kitty-tmux):
#   project  NAME   NEC project      nec_projects/YYYY<name_in_snake_case>     (Box)
#   patent   NAME   NEC patent       patents/YYYY<NameInCamelCase>             (Box)
#   paper    NAME   paper            papers_current/YYYY<venue_name>, git init
#   code     NAME   code project     ~/code/projects/<name-in-kebab-case>, git init
#   talk     DESC   NEC presentation claude "/nec-presentation DESC" in ~/code/presentations (the skill names the deck)
# A NAME that already starts with a year keeps it. --mail also saves the email open in Outlook, with its attachments,
# into the new folder (for a talk: presentations/materials/YYYYMMDD-<slug>/, named in the prompt).
# --send / --send-copy moves / copies the files `sendto --take` gives (stashed by the Alfred file action "Send to
# project folder" or dl/shot in the last 2 minutes, else Finder's selection) into the new folder the same way.
# Usage: mknew [--mail] [--send|--send-copy] KIND NAME...
#        mknew --alfred QUERY       Alfred Script Filter JSON (keyword `new`, ctrl-opt-cmd-N; Outlook in front → --mail)
#        mknew --alfred-send QUERY  the same for keyword `sendtonew`: the files (⌘ copy), or with Outlook in front
#                                   and nothing stashed the email (⌥ move the files, ⌘ copy them)
set -euo pipefail
PATH=/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$PATH
bin=$(dirname "$(realpath "$0")")
die() { notify "$*"; exit 1; }
notify() {
  printf '%s\n' "$1" >&2
  [ -t 2 ] || osascript -e "display notification \"$(printf '%s' "$1" | sed 's/["\\]/\\&/g')\" with title \"mknew\"" >/dev/null 2>&1 || true
}
shortcut_dir() { "$bin/shortcut" ls | awk -v n="$1" '$1 == n {sub(/^[^ ]+ +[^ ]+ +/, ""); print; exit}'; }

# canonical kind for a (prefix of a) kind name or alias
kind_of() {
  local k
  for k in project patent paper code talk presentation deck slides; do
    [[ -n $1 && $k == "$1"* ]] || continue
    case $k in presentation | deck | slides) echo talk ;; *) echo "$k" ;; esac
    return
  done
}

year_prefix() { [[ $1 =~ ^[0-9]{4} ]] && echo "$1" || echo "$(date +%Y)$1"; }
words() { printf '%s' "$1" | tr -c 'A-Za-z0-9' ' ' | xargs; }
target() { # KIND NAME → folder (talk: the materials folder)
  local w
  w=$(words "$2")
  [ -n "$w" ] || return 1
  case $1 in
    project) echo "$(shortcut_dir nec_projects)/$(year_prefix "$(tr 'A-Z ' 'a-z_' <<<"$w")")" ;;
    patent) echo "$(shortcut_dir patents)/$(year_prefix "$(awk '{for (i = 1; i <= NF; i++) printf "%s", toupper(substr($i, 1, 1)) substr($i, 2)}' <<<"$w")")" ;;
    paper) echo "$(shortcut_dir papers_current)/$(year_prefix "$(tr 'A-Z ' 'a-z_' <<<"$w")")" ;;
    code) echo "$HOME/code/projects/$(tr 'A-Z ' 'a-z-' <<<"$w")" ;;
    talk) echo "$(shortcut_dir presentations)/materials/$(date +%Y%m%d)-$(cut -d' ' -f1-4 <<<"$w" | tr 'A-Z ' 'a-z-')" ;;
  esac
}

# move (send=move) or copy (send=copy) the files from `sendto --take` into DIR; prints how many
send_files() {
  local dir=$1 paths=() f
  while IFS= read -r f; do [ -n "$f" ] && paths+=("$f"); done < <("$bin/sendto" --take)
  [ ${#paths[@]} -gt 0 ] || { echo 0; return; }
  if [ "$send" = copy ]; then "$bin/sendto" -c "$dir" "${paths[@]}" >&2; else "$bin/sendto" "$dir" "${paths[@]}" >&2; fi
  echo "${#paths[@]}"
}

create() {
  local mail=$1 kind=$2 name=$3 dir saved= sent=0 what
  dir=$(target "$kind" "$name") || die "no name given"
  if [ "$kind" = talk ]; then
    if [ -n "$mail$send" ]; then
      mkdir -p "$dir"
      if [ -n "$mail" ]; then
        saved=$("$bin/outlook-save" "$dir" 2>&1) || { notify "email not saved: $saved"; saved=; }
      fi
      [ -n "$send" ] && sent=$(send_files "$dir")
      what=${saved:+an email and its attachments}
      [ "$sent" -gt 0 ] && what+="${what:+, and }$sent file(s)"
      [ -n "$what" ] && name+=$'\n\n'"Material for the talk ($what) is in $dir — read it first."
      [ -n "$what" ] || rmdir "$dir" 2>/dev/null || true
    fi
    "$bin/kitty-tmux" --project "$(shortcut_dir presentations)" --name "talk-$(basename "$dir" | cut -c10-)" \
      --claude "/nec-presentation $name"
    return
  fi
  [ -e "$dir" ] && die "already exists: ${dir/#$HOME/~}"
  mkdir -p "$dir"
  case $kind in paper | code) git -C "$dir" init -q ;; esac
  if [ -n "$mail" ]; then
    saved=$("$bin/outlook-save" "$dir" 2>&1) || { notify "email not saved: $saved"; saved=; }
  fi
  [ -n "$send" ] && sent=$(send_files "$dir")
  what=${saved:+the email and $(($(wc -l <<<"$saved") - 1)) attachment(s)}
  [ "$sent" -gt 0 ] && what+="${what:+ and }$sent file(s) ($send)"
  notify "created ${dir/#$HOME/~}${what:+ with $what}"
  "$bin/kitty-tmux" --project "$dir"
}

alfred() { # QUERY [send]: for `sendtonew`, also send the files (or the Outlook email) to the new folder
  local q=$1 sending=${2:-} first rest kind mail= n=0
  read -r first rest <<<"$q" || true
  kind=$(kind_of "$first")
  if [ -n "$sending" ]; then
    n=$("$bin/sendto" --files | wc -l | tr -d ' ')
    ! "$bin/sendto" --stashed && "$bin/outlook-save" --frontmost && mail=1
  else
    "$bin/outlook-save" --frontmost && mail=1
  fi
  {
    if [ -z "$kind" ] || [ -z "$rest" ]; then
      for k in project patent paper code talk; do
        [[ -z $first || $k == "$first"* || $k == "$kind" ]] || continue
        printf 'kind\t%s\t\n' "$k"
      done
    else
      printf 'item\t%s\t%s\t%s\n' "$kind" "$rest" "$(target "$kind" "$rest")"
    fi
  } | python3 -I -c '
import json, os, sys
mail, home, sending, n = sys.argv[1] == "1", os.path.expanduser("~"), sys.argv[2] == "1", int(sys.argv[3])
files = f"{n} item" + ("s" if n != 1 else "") if n else "nothing selected in Finder"
what = {"project": "NEC project (Box)", "patent": "NEC patent (Box)", "paper": "paper in papers/current",
        "code": "code project in ~/code/projects", "talk": "NEC presentation (claude /nec-presentation)"}
hint = {"talk": "DESCRIPTION"}
items = []
for line in sys.stdin.read().splitlines():
    f = line.split("\t")
    if f[0] == "kind":
        items.append({"title": "new " + f[1] + " " + hint.get(f[1], "NAME"), "subtitle": what[f[1]],
                      "autocomplete": f[1] + " ", "valid": False})
        continue
    _, kind, name, path = f
    short = "~" + path[len(home):] if path.startswith(home) else path
    title = f"Presentation: {name}" if kind == "talk" else os.path.basename(path)
    sub = "claude /nec-presentation in ~/code/presentations" if kind == "talk" else f"{what[kind]}: {short}"
    item = {"title": title, "subtitle": sub, "arg": name, "variables": {"kind": kind, "mail": "", "send": ""}}
    if sending:
        v = lambda m, s: {"kind": kind, "mail": m, "send": s}
        copy = {"arg": name, "subtitle": f"{sub}  + copy {files}", "variables": v("", "copy")}
        if mail:
            item["subtitle"] += "  + the Outlook email & attachments (⌥ move " + files + ", ⌘ copy)"
            item["variables"] = v("1", "")
            item["mods"] = {"alt": {"arg": name, "subtitle": f"{sub}  + move {files}", "variables": v("", "move")}, "cmd": copy}
        else:
            item["subtitle"] += f"  + move {files} (⌘ copy)"
            item["variables"] = v("", "move")
            item["mods"] = {"cmd": copy}
    elif mail:
        item["subtitle"] += "  + the Outlook email & attachments (⌥ without)"
        item["variables"]["mail"] = "1"
        item["mods"] = {"alt": {"arg": name, "subtitle": sub + "  (without the email)", "variables": {"kind": kind, "mail": "", "send": ""}}}
    if kind != "talk" and os.path.exists(path):
        item.update(valid=False, subtitle="already exists: " + short)
    items.append(item)
print(json.dumps({"items": items}))' "$mail" "${sending:+1}" "$n"
}

send=
mail=
while :; do
  case ${1:-} in
    --mail) mail=1; shift ;;
    --send | --send-move) send=move; shift ;;
    --send-copy) send=copy; shift ;;
    *) break ;;
  esac
done
case ${1:-} in
  --alfred) alfred "${2:-}" ;;
  --alfred-send) alfred "${2:-}" send ;;
  '' | -h | --help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) k=$(kind_of "$1"); [ -n "$k" ] || die "unknown kind: $1"; shift; create "$mail" "$k" "$*" ;;
esac
