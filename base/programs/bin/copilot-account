#!/usr/bin/env bash
# Which GitHub account GitHub Copilot uses: Neovim (copilot.lua, base/nvim/.config/nvim/lua/plugins/ai.lua)
# and the Copilot CLI (`copilot`, also inside sidekick.nvim). The choice is stored as "LABEL HOST" in
# ~/.config/copilot-account (per machine, not in the repo); without the file the NEC GHE account is used.
#   yassernec           NEC GitHub Enterprise Cloud (EMU) tenant nec-corporation-emu.ghe.com, login ymohammad-253f3ddf (default)
#   yassernec-personal  the old github.com account (y.mohammad@nec.com; was "yassernec" on github.com)
# copilot.lua reads it at startup (auth_provider_url = https://HOST/ unless github.com); .exports reads it in
# every new shell (COPILOT_GH_HOST=HOST, unset for github.com). Both accounts stay signed in side by side.
# Usage: copilot-account                         show the selected account and the signed-in Copilot/gh accounts
#        copilot-account yassernec|yassernec-personal   select one (restart nvim / open a new shell)
#        copilot-account host                    print the selected host
set -euo pipefail
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
state=${XDG_CONFIG_HOME:-$HOME/.config}/copilot-account
default_label=yassernec

host_of() {
  case $1 in
    yassernec) echo nec-corporation-emu.ghe.com ;;
    yassernec-personal) echo github.com ;;
    *) echo "copilot-account: unknown account '$1' (yassernec, yassernec-personal)" >&2; return 1 ;;
  esac
}

current() { # prints "LABEL HOST"
  local label host
  if [ -r "$state" ] && read -r label host <"$state" && [ -n "${host:-}" ]; then
    echo "$label $host"
  else
    echo "$default_label $(host_of "$default_label")"
  fi
}

status() {
  local label host
  read -r label host < <(current)
  echo "Copilot account: $label ($host)$([ -r "$state" ] || echo ', default')"
  local db=$HOME/.config/github-copilot/auth.db
  if [ -r "$db" ] && command -v sqlite3 >/dev/null; then
    echo "Neovim (copilot.lua) sign-ins:"
    sqlite3 -separator ' ' "$db" "select '  '||auth_authority, user_login from oauth_tokens order by auth_authority" 2>/dev/null || true
    sqlite3 "$db" "select auth_authority from oauth_tokens" 2>/dev/null | grep -qx "$host" ||
      echo "  (none for $host yet: in nvim run :Copilot auth)"
  fi
  if [ -r "$HOME/.copilot/config.json" ]; then
    echo "Copilot CLI sign-ins:"
    sed 's#^ *//.*##' "$HOME/.copilot/config.json" | python3 -I -c '
import json, sys
for u in json.load(sys.stdin).get("loggedInUsers", []):
    if "github" in u.get("host", "") or u.get("kind") in ("githubDotCom", "proxima"):
        print("  " + u["host"].removeprefix("https://"), u["login"])' 2>/dev/null || true
    [ "${COPILOT_GH_HOST:-github.com}" = "$host" ] ||
      echo "  (this shell has COPILOT_GH_HOST=${COPILOT_GH_HOST:-unset}; a new shell picks up $host)"
  fi
}

case ${1:-} in
  "" | status) status ;;
  host) current | cut -d' ' -f2 ;;
  -h | --help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    host=$(host_of "$1")
    mkdir -p "$(dirname "$state")"
    echo "$1 $host" >"$state"
    echo "Copilot account: $1 ($host)"
    echo "Restart Neovim (if :Copilot status says not signed in: :Copilot auth); new shells use it for the copilot CLI"
    echo "(this shell: export COPILOT_GH_HOST=$host$([ "$host" = github.com ] && echo ' or unset COPILOT_GH_HOST'))"
    ;;
esac
