#!/usr/bin/env bash
# Run-a-command popup for tmux (Alt-r, prefix-R): opened in the current pane's folder, prompts for a
# command in nvim via popup-edit (recent shell-history commands above the input line to search and edit;
# readline when nvim is missing), runs it in an interactive shell of the preferred kind (~/bin/preferred-shell:
# zsh or bash) so aliases/functions work, then waits: Enter/r = run another, any other key (q, Esc, Space…) = close.
# `tmux-run-popup CMD…` runs CMD first. Ctrl-C or an empty line at the prompt closes too.
here=$(cd "$(dirname "$0")" && pwd)
sh=$("$here/preferred-shell" 2>/dev/null || command -v zsh || command -v bash)
case ${sh##*/} in
  zsh) hist=$HOME/.z_history; syntax=zsh ;;   # HISTFILE in .exports
  *)   hist=$HOME/.bash_history; syntax=bash ;;
esac

# the last 300 distinct commands, oldest first (zsh's ": <time>:0;" prefix stripped)
recent() {
  # zsh stores some bytes "metafied" (0x83, then the byte xor 0x20): undo that; LC_ALL=C for the byte work
  tail -n 3000 "$hist" 2>/dev/null | LC_ALL=C perl -pe '$_ = "" if /^#\d+$/; s/^: \d+:\d+;//; s/\x83(.)/chr(ord($1) ^ 32)/ge' |
    LC_ALL=C awk '
      # multi-line entries (lines ending in a backslash) become one line with literal \n, as `fc -ln` shows them
      { if (cont) { l[m] = l[m] "\\n" $0 } else { l[++m] = $0 } cont = sub(/\\$/, "", l[m]) }
      END { for (i = m; i > 0 && n < 300; i--) if (l[i] != "" && !seen[l[i]]++) o[++n] = l[i]; for (i = n; i > 0; i--) print o[i] }'
}

cmd="$*"
while true; do
  if [ -z "$cmd" ]; then
    # popup-edit: nvim (full config, no chrome) with the history above the input line (search / ?, edit any of
    # them); Enter / C-s runs the line under the cursor.
    cmd=$(recent | "$here/popup-edit" --line --history --syntax $syntax --hint "${PWD/#$HOME/~}   Enter / C-s: run · C-c: close")
    case $? in
      0) ;;
      3) printf '\033[34m%s\033[0m\n' "${PWD/#$HOME/~}"
         IFS= read -r -e -p $'\001\033[32m\002❯\001\033[0m\002 ' cmd || exit 0 ;;
      *) exit 0 ;;
    esac
    [ -z "${cmd// /}" ] && exit 0
    if [ $syntax = zsh ]; then printf ': %s:0;%s\n' "$(date +%s)" "$cmd" >>"$hist"; else printf '%s\n' "$cmd" >>"$hist"; fi
  fi
  "$sh" -ic "$cmd"
  rc=$?
  cmd=
  if [ $rc -eq 0 ]; then printf '\n\033[32m✔ done\033[0m'; else printf '\n\033[31m✘ exit %s\033[0m' $rc; fi
  printf '  \033[90mEnter: run another · any other key: close\033[0m'
  IFS= read -rsn1 key || exit 0
  [ -z "$key" ] || [ "$key" = r ] || exit 0
  echo
done
