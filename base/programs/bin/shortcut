#!/usr/bin/env bash
# Folder shortcuts kept in ~/.config/shortcuts/dirs ("name key path" per line) and mirrored to:
#   ~/.exports ($NAME, read at shell start)   yazi yamb bookmarks (init.lua reads the list)
#   tmux Alt-g picker (tmux-dir-pick)          zoxide + sesh sessions (written by `shortcut sync`)
# Usage: shortcut add <name> [path=.] [key]   add or replace a shortcut, then sync
#        shortcut rm <name>                  remove a shortcut, then sync
#        shortcut ls | paths | sync
set -euo pipefail
list=${SHORTCUTS_FILE:-$HOME/.config/shortcuts/dirs}
sesh_out=$HOME/.config/sesh/shortcuts.toml
yamb_file=$HOME/.config/yazi/bookmark
die() { echo "shortcut: $*" >&2; exit 1; }

# entries as "name<TAB>key<TAB>abs path"
entries() {
  [ -r "$list" ] || return 0
  awk -v home="$HOME" '!/^[[:space:]]*(#|$)/ {
    p = $0; sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/, "", p)
    sub(/[[:space:]]+$/, "", p); sub(/^~/, home, p)
    if (p != "/") sub(/\/$/, "", p)
    print $1 "\t" $2 "\t" p }' "$list"
}

sync() {
  local name key path
  if command -v zoxide >/dev/null; then
    entries | while IFS=$'\t' read -r name key path; do if [ -d "$path" ]; then zoxide add "$path"; fi; done
  fi
  { echo "# Generated by ~/bin/shortcut from ~/.config/shortcuts/dirs; edit that file instead."
    entries | while IFS=$'\t' read -r name key path; do
      printf '\n[[session]]\nname = "%s"\npath = "%s"\n' "$name" "${path/#$HOME/\~}"
    done; } > "$sesh_out"
  # yamb keeps its own copy of every bookmark keyed by path; drop ours so init.lua's tags/keys win
  if [ -f "$yamb_file" ]; then
    awk -F'\t' 'NR == FNR { p[$3] = 1; p[$3 "/"] = 1; next } !($2 in p)' \
      <(entries) "$yamb_file" > "$yamb_file.tmp" && mv "$yamb_file.tmp" "$yamb_file"
  fi
}

cmd=${1:-ls}; shift || true
case $cmd in
  ls) entries | column -t -s $'\t' ;;
  paths) entries | cut -f3 ;;
  sync) sync ;;
  add)
    [ $# -ge 1 ] || die "usage: shortcut add <name> [path=.] [key]"
    name=$1 path=${2:-.} key=${3:--}
    [[ $name =~ ^[a-z][a-z0-9_]*$ ]] || die "name must match [a-z][a-z0-9_]* (it becomes \$${name^^})"
    [ ${#key} -eq 1 ] || die "key must be a single character (or - for none)"
    path=$(cd "$path" 2>/dev/null && pwd -P) || die "no such directory: ${2:-.}"
    var=${name^^}
    if [ "$var" = HOME ] || { [ -n "${!var:-}" ] && ! entries | cut -f1 | grep -x "$name" >/dev/null; }; then
      die "\$$var is already set in the environment; pick another name"
    fi
    if [ "$key" != - ] && entries | awk -F'\t' -v n="$name" -v k="$key" '$1 != n && $2 == k {f=1} END {exit !f}'; then
      die "yazi key '$key' is taken: $(entries | awk -F'\t' -v k="$key" '$2 == k {print $1}')"
    fi
    short=${path/#$HOME/\~}
    tmp=$(mktemp)
    awk -v n="$name" '$1 != n' "$list" > "$tmp"
    printf '%-15s %s  %s\n' "$name" "$key" "$short" >> "$tmp"
    cat "$tmp" > "$list"; rm -f "$tmp"   # write through the stow symlink
    sync
    [ "$key" = - ] && yk= || yk=", yazi g; $key"
    echo "added $name -> $short (\$$var, sesh '$name'$yk); open a new shell / restart yazi to pick it up" ;;
  rm)
    [ $# -eq 1 ] || die "usage: shortcut rm <name>"
    entries | cut -f1 | grep -x "$1" >/dev/null || die "no shortcut named $1"
    tmp=$(mktemp); awk -v n="$1" '$1 != n' "$list" > "$tmp"; cat "$tmp" > "$list"; rm -f "$tmp"
    sync; echo "removed $1" ;;
  *) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 1 ;;
esac
