#!/usr/bin/env bash
# Directory picker for tmux popups (prefix-g, Alt-g) over ~/bin/project-dirs; opens each selection with
# `tmuxinator any`.
~/bin/project-dirs |
  fzf --multi --height=100% --preview-window=right:50% --preview 'ls -A --color=always {} 2>/dev/null || ls -AG {}' |
  xargs -I {} tmuxinator any {}
