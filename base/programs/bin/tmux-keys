#!/usr/bin/env bash
# Searchable tmux shortcut list (Alt-u, prefix-?): every root/prefix binding (copy-mode and mouse ones
# left out) with its description — the `bind -N` note, else the comment above the bind in ~/.tmux.conf —
# in fzf; Enter runs the chosen binding's command. The popup can't run it itself (no popup inside a
# popup, and it would lose the client context), so the command goes to $out and the key binding
# sources that file once the popup has closed. Plain bash + awk (bash 3.2 is enough).
out=/tmp/tmux-keys-$(id -u).conf
/bin/rm -f "$out"
prefix=$(tmux show -gv prefix)

# descriptions as "table:key<TAB>text" lines; later lines win
descs() {
  # comments above each bind in the config (a comment block applies to all binds right under it)
  local conf=~/.tmux.conf
  [ -r "$conf" ] && awk '
    /^[[:space:]]*#/ { sub(/^[[:space:]]*#+[[:space:]]?/, ""); c = (c == "" || b ? $0 : c " " $0); b = 0; next }
    /^[[:space:]]*(bind|bind-key)[[:space:]]/ {
      t = "prefix"
      for (i = 2; i <= NF && $i ~ /^-/; i++) {
        if ($i ~ /n/) t = "root"
        if ($i ~ /T$/) t = $(++i)
        else if ($i ~ /N$/) i++
      }
      k = $i; gsub(/^["\x27]|["\x27]$/, "", k); sub(/^\\/, "", k)
      d = c; if (match($0, /[[:space:]]#[[:space:]]/)) d = substr($0, RSTART + 3)
      if (d != "") print t ":" k "\t" d
      b = 1; next
    }
    { c = ""; b = 0 }' "$conf"
  # tmux notes (default bindings and bind -N) win
  local t
  for t in prefix root; do
    tmux list-keys -N -T $t 2>/dev/null | awk -v t=$t -v p="$prefix" '{
      line = $0
      if (t == "prefix" && index(line, p " ") == 1) line = substr(line, length(p) + 2)
      if (match(line, /^[^ ]+ +/)) {
        k = substr(line, 1, RLENGTH); sub(/ +$/, "", k); sub(/^\\/, "", k)
        print t ":" k "\t" substr(line, RLENGTH + 1)
      }
    }'
  done
}

tab=$'\t'
sel=$( { descs | sed "s/^/D$tab/"; tmux list-keys | sed "s/^/K$tab/"; } | awk -F'\t' -v p="$prefix" '
  $1 == "D" { d[$2] = $3; next }
  {
    line = substr($0, 3)
    if (line !~ /^bind-key +(-r +)?-T +[^ ]+ +[^ ]+ +/) next
    sub(/^bind-key +(-r +)?-T +/, "", line)
    t = line; sub(/ .*/, "", t); line = substr(line, length(t) + 1); sub(/^ +/, "", line)
    k = line; sub(/ .*/, "", k); cmd = substr(line, length(k) + 1); sub(/^ +/, "", cmd)
    if (t ~ /^copy-mode/ || k ~ /Mouse|Click|Wheel|Drag/) next
    kk = k; sub(/^\\/, "", kk)
    if (t == "prefix") { label = p " " kk; o = 0 } else if (t == "root") { label = kk; o = 1 } else { label = t " " kk; o = 2 }
    desc = d[t ":" kk]
    print o "\t" label "\t" desc "\t" cmd
  }' | sort -t$'\t' -k1,1n -k2,2 | cut -f2- | awk -F'\t' '{ printf "%-16s\t%s\t%s\n", $1, ($2 == "" ? "·" : $2), $3 }' |
  fzf --reverse --height=100% --delimiter=$'\t' --with-nth=1,2 --nth=1,2,3 \
    --prompt='keys> ' --header='Enter: run · Esc: close · search matches key, description and command' \
    --preview='printf "%s\n" {3}' --preview-window=down,4,wrap)
[ -n "$sel" ] && printf '%s\n' "$sel" | cut -f3 >"$out"
exit 0
