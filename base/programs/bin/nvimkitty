#!/usr/bin/env bash
# Open text files in nvim and folders in yazi inside kitty (VS Code / Finder when those are missing), and make
# that the macOS default for Markdown, plain text, LaTeX, CSV, source code and similar files, and for folders.
# Usage: nvimkitty [FILE|DIR...]      open the files (no file: an empty nvim); a first argument that is a folder opens yazi
#        nvimkitty yazi [PATH...]     open yazi in kitty at the folders (a file: its folder, with the file selected)
#        nvimkitty install            build ~/Applications/NvimKitty.app, make it the default handler, and add the
#                                     Finder Quick Action "Open in Yazi" (right-click, or ctrl-opt-cmd-Y)
#        nvimkitty uninstall          remove the app (folders go back to Finder; text falls back to the next handler)
#        nvimkitty status             show which app opens each file type
# The app is a thin AppleScript applet that calls this script, so the behaviour lives here, in the dotfiles.
set -euo pipefail
app=$HOME/Applications/NvimKitty.app
service_name="Open in Yazi"
service=$HOME/Library/Services/$service_name.workflow
service_key='^~@y'   # ctrl-opt-cmd-Y
bundle_id=com.yasser.nvimkitty
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
kitty_bin=/Applications/kitty.app/Contents/MacOS/kitty
vscode_id=com.microsoft.VSCode
# extensions to take over. install asks LaunchServices for each one's type (UTI) and takes that type over
# (org.tug.tex from TeXShop, public.comma-separated-values-text from Numbers, public.c-source from Xcode, ...);
# an extension with no type of its own (dyn.*) is declared by the app as com.yasser.nvimkitty.<ext>.
# Left out on purpose: html/svg/rtf/plist/ipynb (better in their apps) and ts (MPEG transport stream to macOS).
exts=(md markdown txt text log json yaml yml toml ini conf cfg env rst org adoc typ qmd rmd
      tex ltx sty cls dtx ins bib bst bbl aux tikz ris
      csv tsv
      sh bash zsh fish py lua vim r jl c h cc cpp hpp rs go java kt scala swift rb pl php hs ml el
      js mjs jsx tsx css scss sql xml diff patch mk cmake nix tf gp sbt gradle properties lock)
# types taken over even when no extension maps to them (yet): generic text, and the types TeXShop, BibDesk and
# Sequel Ace declare, so installing one of those later on a new machine does not hand them .tex/.bib/.sql
extra_utis=(public.utf8-plain-text public.script
            org.tug.tex org.tug.ltx org.tug.sty org.tug.cls org.tug.dtx org.tug.tex.bibtex org.tug.bst org.tug.aux
            org.tug.lua com.unknown.ins com.unknown.adoc com.unknown.typ net.sourceforge.bibdesk.ris
            com.sequel-ace.sequel-ace.sql)
# folders: public.folder only, never public.directory (that would also catch .app bundles and other packages)
folder_uti=public.folder
finder_id=com.apple.finder
utis=() declared_exts=()   # filled by resolve_types
die() { echo "nvimkitty: $*" >&2; exit 1; }

# GUI launches get a bare PATH, so look in the usual places
find_bin() {
  local b
  for b in "/opt/homebrew/bin/$1" "/usr/local/bin/$1" "$HOME/.local/bin/$1"; do [ -x "$b" ] && { echo "$b"; return; }; done
  command -v "$1" 2>/dev/null || true
}

have_kitty() { [ -x "$kitty_bin" ] && [ -n "$(find_bin nvim)" ]; }
have_yazi() { [ -x "$kitty_bin" ] && [ -n "$(find_bin yazi)" ]; }

open_dirs() {
  [ $# -gt 0 ] || set -- "$HOME"
  if have_yazi; then
    local dir=$1
    [ -d "$dir" ] || dir=$(dirname "$dir")
    # each extra folder becomes a yazi tab; a file opens its folder with the file selected
    nohup "$kitty_bin" --single-instance --directory "$dir" "$(find_bin yazi)" "$@" >/dev/null 2>&1 &
  else
    # by Finder's bundle id: a plain `open` would come straight back here when this app is the folder handler
    open -b "$finder_id" "$@"
  fi
}

open_files() {
  [ $# -gt 0 ] && [ -d "$1" ] && { open_dirs "$@"; return; }
  if have_kitty; then
    local nvim dir
    nvim=$(find_bin nvim)
    dir=$PWD
    [ $# -gt 0 ] && dir=$(cd "$(dirname "$1")" && pwd)
    # --single-instance: a new OS window in the running kitty, if there is one
    nohup "$kitty_bin" --single-instance --directory "$dir" "$nvim" "$@" >/dev/null 2>&1 &
  elif [ -d "/Applications/Visual Studio Code.app" ]; then
    open -b "$vscode_id" "$@"
  else
    die "neither kitty+nvim nor VS Code is installed"
  fi
}

# ext_uti EXT: the type LaunchServices gives a .EXT file (mdls on an empty probe file)
ext_uti() {
  local tmp u
  tmp=$(mktemp -d)
  : >"$tmp/probe.$1"
  u=$(mdls -raw -name kMDItemContentType "$tmp/probe.$1" 2>/dev/null || true)
  rm -rf "$tmp"
  echo "$u"
}

# fill utis (system types to take over, each once) and declared_exts (extensions the app declares itself);
# types the app declared on an earlier install count as declared again
resolve_types() {
  local e u seen=" "
  utis=("${extra_utis[@]}") declared_exts=()
  for e in "${exts[@]}"; do
    u=$(ext_uti "$e")
    case $u in
      dyn.*|""|"(null)"|"$bundle_id".*) declared_exts+=("$e"); u=$bundle_id.$e ;;
    esac
    case $seen in *" $u "*) continue ;; esac
    seen+="$u "
    utis+=("$u")
  done
}

plist_doc_types() {
  local p=$1 i=0 u e
  /usr/libexec/PlistBuddy -c "Delete :CFBundleDocumentTypes" "$p" 2>/dev/null || true
  /usr/libexec/PlistBuddy -c "Delete :UTImportedTypeDeclarations" "$p" 2>/dev/null || true
  /usr/libexec/PlistBuddy \
    -c "Add :CFBundleDocumentTypes array" -c "Add :CFBundleDocumentTypes:0 dict" \
    -c "Add :CFBundleDocumentTypes:0:CFBundleTypeName string Text" \
    -c "Add :CFBundleDocumentTypes:0:CFBundleTypeRole string Editor" \
    -c "Add :CFBundleDocumentTypes:0:LSHandlerRank string Alternate" \
    -c "Add :CFBundleDocumentTypes:0:LSItemContentTypes array" \
    -c "Add :CFBundleDocumentTypes:0:CFBundleTypeExtensions array" \
    -c "Add :CFBundleDocumentTypes:1 dict" \
    -c "Add :CFBundleDocumentTypes:1:CFBundleTypeName string Folder" \
    -c "Add :CFBundleDocumentTypes:1:CFBundleTypeRole string Viewer" \
    -c "Add :CFBundleDocumentTypes:1:LSHandlerRank string Alternate" \
    -c "Add :CFBundleDocumentTypes:1:LSItemContentTypes array" \
    -c "Add :CFBundleDocumentTypes:1:LSItemContentTypes:0 string $folder_uti" \
    -c "Add :UTImportedTypeDeclarations array" "$p"
  resolve_types
  for u in "${utis[@]}"; do
    /usr/libexec/PlistBuddy -c "Add :CFBundleDocumentTypes:0:LSItemContentTypes:$i string $u" "$p"; i=$((i + 1))
  done
  local j=0
  for e in "${declared_exts[@]}"; do
    /usr/libexec/PlistBuddy \
      -c "Add :UTImportedTypeDeclarations:$j dict" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeIdentifier string $bundle_id.$e" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeDescription string .$e text file" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeConformsTo array" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeConformsTo:0 string public.plain-text" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeTagSpecification dict" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeTagSpecification:public.filename-extension array" \
      -c "Add :UTImportedTypeDeclarations:$j:UTTypeTagSpecification:public.filename-extension:0 string $e" "$p"
    j=$((j + 1))
  done
  i=0
  for e in "${exts[@]}"; do
    /usr/libexec/PlistBuddy -c "Add :CFBundleDocumentTypes:0:CFBundleTypeExtensions:$i string $e" "$p"; i=$((i + 1))
  done
}

self_path() {
  local self=$HOME/bin/nvimkitty
  [ -x "$self" ] || self=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/nvimkitty
  echo "$self"
}

build_app() {
  local self src
  self=$(self_path)
  src=$(mktemp -d)/NvimKitty.applescript
  cat >"$src" <<EOF
on open theFiles
	set args to ""
	repeat with f in theFiles
		set args to args & " " & quoted form of (POSIX path of f)
	end repeat
	do shell script quoted form of "$self" & args & " > /dev/null 2>&1 &"
end open

on run
	do shell script quoted form of "$self" & " > /dev/null 2>&1 &"
end run
EOF
  mkdir -p "$HOME/Applications"
  rm -rf "$app"
  osacompile -o "$app" "$src"
  local p=$app/Contents/Info.plist
  /usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $bundle_id" "$p" 2>/dev/null \
    || /usr/libexec/PlistBuddy -c "Add :CFBundleIdentifier string $bundle_id" "$p"
  /usr/libexec/PlistBuddy -c "Set :CFBundleName NvimKitty" "$p" 2>/dev/null || true
  plist_doc_types "$p"
  plutil -lint -s "$p"
  codesign --force --deep -s - "$app" 2>/dev/null
  "$lsregister" -f "$app"
}

# Finder Quick Action (Automator service) on selected files/folders: runs `nvimkitty yazi <selection>`
build_service() {
  local self
  self=$(self_path)
  rm -rf "$service"
  mkdir -p "$service/Contents"
  cat >"$service/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict><key>default</key><string>$service_name</string></dict>
			<key>NSMessage</key>
			<string>runWorkflowAsService</string>
			<key>NSRequiredContext</key>
			<dict><key>NSApplicationIdentifier</key><string>$finder_id</string></dict>
			<key>NSSendFileTypes</key>
			<array><string>public.item</string></array>
		</dict>
	</array>
</dict>
</plist>
EOF
  cat >"$service/Contents/document.wflow" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMApplicationBuild</key><string>534</string>
	<key>AMApplicationVersion</key><string>2.10</string>
	<key>AMDocumentVersion</key><string>2</string>
	<key>actions</key>
	<array>
		<dict>
			<key>action</key>
			<dict>
				<key>AMAccepts</key>
				<dict>
					<key>Container</key><string>List</string>
					<key>Optional</key><true/>
					<key>Types</key><array><string>com.apple.cocoa.string</string></array>
				</dict>
				<key>AMActionVersion</key><string>2.0.3</string>
				<key>AMApplication</key><array><string>Automator</string></array>
				<key>AMParameterProperties</key>
				<dict>
					<key>COMMAND_STRING</key><dict/>
					<key>CheckedForUserDefaultShell</key><dict/>
					<key>inputMethod</key><dict/>
					<key>shell</key><dict/>
					<key>source</key><dict/>
				</dict>
				<key>AMProvides</key>
				<dict>
					<key>Container</key><string>List</string>
					<key>Types</key><array><string>com.apple.cocoa.string</string></array>
				</dict>
				<key>ActionBundlePath</key><string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key><string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key><string>'$self' yazi "\$@"</string>
					<key>CheckedForUserDefaultShell</key><true/>
					<key>inputMethod</key><integer>1</integer>
					<key>shell</key><string>/bin/bash</string>
					<key>source</key><string></string>
				</dict>
				<key>BundleIdentifier</key><string>com.apple.RunShellScript</string>
				<key>CFBundleVersion</key><string>2.0.3</string>
				<key>CanShowSelectedItemsWhenRun</key><false/>
				<key>CanShowWhenRun</key><true/>
				<key>Category</key><array><string>AMCategoryUtilities</string></array>
				<key>Class Name</key><string>RunShellScriptAction</string>
				<key>InputUUID</key><string>5B0E7C1A-6F3D-4C55-9E21-0A7F3C2D9B11</string>
				<key>OutputUUID</key><string>8D4A2E6F-1B7C-4F09-A3D5-6C2E9F0B7A22</string>
				<key>UUID</key><string>C3F91D84-2A6E-4B7D-8E15-9F0A4C6B2D33</string>
				<key>UnlocalizedApplications</key><array><string>Automator</string></array>
				<key>isViewVisible</key><integer>1</integer>
				<key>location</key><string>309.000000:305.000000</string>
				<key>nibPath</key><string>/System/Library/Automator/Run Shell Script.action/Contents/Resources/Base.lproj/main.nib</string>
			</dict>
			<key>isViewVisible</key><integer>1</integer>
		</dict>
	</array>
	<key>connectors</key><dict/>
	<key>workflowMetaData</key>
	<dict>
		<key>applicationBundleID</key><string>$finder_id</string>
		<key>applicationPath</key><string>/System/Library/CoreServices/Finder.app</string>
		<key>inputTypeIdentifier</key><string>com.apple.Automator.fileSystemObject</string>
		<key>outputTypeIdentifier</key><string>com.apple.Automator.nothing</string>
		<key>presentationMode</key><integer>15</integer>
		<key>processesInput</key><false/>
		<key>serviceApplicationBundleID</key><string>$finder_id</string>
		<key>serviceApplicationPath</key><string>/System/Library/CoreServices/Finder.app</string>
		<key>serviceInputTypeIdentifier</key><string>com.apple.Automator.fileSystemObject</string>
		<key>serviceOutputTypeIdentifier</key><string>com.apple.Automator.nothing</string>
		<key>serviceProcessesInput</key><false/>
		<key>systemImageName</key><string>NSActionTemplate</string>
		<key>useAutomaticInputType</key><false/>
		<key>workflowTypeIdentifier</key><string>com.apple.Automator.servicesMenu</string>
	</dict>
</dict>
</plist>
EOF
  plutil -lint -s "$service/Contents/Info.plist" "$service/Contents/document.wflow"
  # enable it in the context menu with a keyboard shortcut, then make the services list reload
  defaults write pbs NSServicesStatus -dict-add "'(null) - $service_name - runWorkflowAsService'" \
    "{enabled_context_menu = 1; enabled_services_menu = 1; key_equivalent = \"$service_key\"; presentation_modes = {ContextMenu = 1; ServicesMenu = 1;};}"
  /System/Library/CoreServices/pbs -update 2>/dev/null || true
}

duti_bin() {
  local d
  d=$(find_bin duti)
  if [ -z "$d" ]; then
    command -v brew >/dev/null 2>&1 || die "duti missing and Homebrew not found (brew install duti)"
    brew install duti >/dev/null
    d=$(find_bin duti)
  fi
  echo "$d"
}

# LaunchServices picks up a new registration a moment late: retry until each type reports the wanted handler
# set_defaults HANDLER [UTI...]   (default: the text types)
set_defaults() {
  local handler=$1 duti u n
  shift
  duti=$(duti_bin)
  local types=("$@")
  if [ $# -eq 0 ]; then
    [ ${#utis[@]} -gt 0 ] || resolve_types
    # the app's own declared types mean nothing to another handler
    for u in "${utis[@]}"; do
      [ "$handler" != "$bundle_id" ] && [ "${u#"$bundle_id".}" != "$u" ] && continue
      types+=("$u")
    done
  fi
  for n in 1 2 3 4 5; do
    local pending=()
    for u in "${types[@]}"; do
      "$duti" -s "$handler" "$u" all 2>/dev/null || true
      [ "$("$duti" -d "$u" 2>/dev/null)" = "$handler" ] || pending+=("$u")
    done
    [ ${#pending[@]} -eq 0 ] && return 0
    types=("${pending[@]}")
    sleep "$n"
  done
  echo "nvimkitty: could not set $handler for: ${types[*]}" >&2
  return 1
}

install() {
  [ "$(uname)" = Darwin ] || die "install is macOS-only"
  if have_kitty; then
    build_app
    set_defaults "$bundle_id"
    echo "NvimKitty.app is now the default for: ${exts[*]}"
    if have_yazi; then
      build_service
      echo "Finder Quick Action \"$service_name\" installed (right-click > Quick Actions, or ctrl-opt-cmd-Y)"
      # recent macOS refuses (paramErr -50) to hand public.folder to anything but Finder; then `nvimkitty DIR`,
      # or dropping a folder on the app, still opens yazi
      if set_defaults "$bundle_id" "$folder_uti" 2>/dev/null; then
        echo "NvimKitty.app (yazi) is now the default for folders"
      else
        echo "macOS keeps Finder as the folder handler; folders open in yazi only via nvimkitty DIR or the app"
      fi
    else
      echo "yazi not found; folders stay with Finder"
    fi
  elif [ -d "/Applications/Visual Studio Code.app" ]; then
    echo "kitty or nvim not found; making VS Code the default instead"
    set_defaults "$vscode_id"
  else
    die "neither kitty+nvim nor VS Code is installed"
  fi
}

status() {
  local duti u e
  duti=$(duti_bin)
  printf "%-12s %-36s %s\n" ext type handler
  for e in "${exts[@]}"; do
    u=$(ext_uti "$e")
    # Spotlight (mdls) can lag behind the app's own declarations
    case $u in dyn.*|""|"(null)") u=$bundle_id.$e;; esac
    printf ".%-11s %-36s %s\n" "$e" "$u" "$("$duti" -d "$u" 2>/dev/null || true)"
  done
  printf "%-12s %-36s %s\n" "(folder)" "$folder_uti" "$("$duti" -d "$folder_uti" 2>/dev/null || true)"
}

case ${1:-} in
  install) install ;;
  uninstall)
    # folders go back to Finder explicitly; text types fall back to whatever LaunchServices picks next
    [ "$("$(duti_bin)" -d "$folder_uti" 2>/dev/null)" = "$bundle_id" ] && set_defaults "$finder_id" "$folder_uti"
    "$lsregister" -u "$app" 2>/dev/null || true; rm -rf "$app" "$service"; echo "removed $app and $service"
    # (its shortcut entry in pbs NSServicesStatus is left behind, inert without the workflow)
    /System/Library/CoreServices/pbs -update 2>/dev/null || true ;;
  yazi) shift; open_dirs "$@" ;;
  status) status ;;
  -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) open_files "$@" ;;
esac
