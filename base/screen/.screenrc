# GNU Screen configuration - tmux-compatible setup
# ====================================================

# Basic Settings
# --------------
startup_message off           # No startup message
defscrollback 5000           # History limit (tmux: 5000)
altscreen on                 # Alternate screen support (tmux: alternate-screen on)
autodetach on                # Auto-detach on hangup
defutf8 on                   # UTF-8 support
defflow off                  # Disable flow control (Ctrl-S/Ctrl-Q)
vbell off                    # No visual bell
msgwait 1                    # Message display time
defmonitor on                # Monitor windows for activity

# Terminal Settings
# -----------------
term screen-256color         # 256 color support
termcapinfo xterm* ti@:te@   # Enable scrollback in xterm
attrcolor b ".I"             # Allow bold colors
defbce on                    # Erase background with current bg color

# Shell
# -----
shell /bin/zsh

# Prefix Key: C-space (matching tmux)
# -----------------------------------
escape ^Aa                   # C-a is default, but we'll remap below
# Note: Screen doesn't support C-space directly, so we use C-a
# To make it more tmux-like, you can use C-a, but tmux users
# may need to adapt. Screen's limitation.

# Window Numbering (matching tmux base-index 1)
# ----------------------------------------------
bind c screen 1              # Start window numbering at 1
bind ^c screen 1
bind 0 select 10             # Make 0 select window 10

# Window Navigation
# -----------------
bind ^n next                 # Next window (C-a n)
bind ^p prev                 # Previous window (C-a p)
bind n next
bind p prev
bind " " windowlist -b       # Window list (C-a space)
bind ^a other                # Toggle between windows (like tmux Tab)

# Split Windows (matching tmux splits)
# ------------------------------------
bind - split                 # Horizontal split (tmux: split-window -v)
bind | split -v              # Vertical split (tmux: split-window -h)
bind \\ split -v             # Alternative vertical split
bind = split -v              # Alternative vertical split

# Pane Navigation (vim-style)
# ---------------------------
bind h focus left            # Move to left pane
bind j focus down            # Move to down pane
bind k focus up              # Move to up pane
bind l focus right           # Move to right pane
bind ^h focus left
bind ^j focus down
bind ^k focus up
bind ^l focus right

# Pane Resizing
# -------------
bind H resize -h -5          # Shrink horizontal
bind L resize -h +5          # Grow horizontal
bind J resize -v -5          # Shrink vertical
bind K resize -v +5          # Grow vertical

# Reload Configuration
# --------------------
bind r source ~/.screenrc    # Reload config (tmux: bind r source-file)

# Copy Mode (vi-style, matching tmux)
# -----------------------------------
markkeys "h=^B:l=^F:$=^E"    # Vi-like navigation in copy mode
bind ^[ copy                 # Enter copy mode (like tmux Enter)
bind Escape copy             # Alternative copy mode entry

# Detach
# ------
bind d detach                # Detach session
bind ^d detach

# Kill Commands
# -------------
bind K kill                  # Kill current window
bind q quit                  # Quit screen entirely
bind ^q quit

# Session Management
# ------------------
bind t screen                # New window (like tmux C-t)
bind ^t screen

# Mouse Support (limited in screen)
# ---------------------------------
# Screen has limited mouse support compared to tmux
# mousetrack on              # Enable mouse (if supported)

# Status Bar (matching tmux status bar style)
# -------------------------------------------
hardstatus alwayslastline
hardstatus string '%{= kG}[ %{G}%H %{g}][%= %{= kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%?%= %{g}][%{B} %m-%d %{W}%c %{g}]'

# Alternative status bar (simpler, closer to your tmux config)
# hardstatus string '%{= Kd} %{= Kd}%S%{-} %= %{= Kd} %l %{= Kd} %{= Kd}%c %{-}'

# Caption (window list at bottom)
# -------------------------------
caption always "%{= kw}%-w%{= BW}%n %t%{-}%+w %-= @%H - %LD %d %LM - %c"

# Activity Monitoring
# -------------------
activity "Activity in window %n"  # Message on activity
bell_msg "Bell in window %n"      # Message on bell

# Layouts (Screen 4.1+)
# ---------------------
# Screen supports layouts but syntax differs from tmux
layout autosave on           # Auto-save layout
layout new default           # Create default layout

# Window Titles
# -------------
shelltitle "$ |zsh"          # Set shell title
defhstatus "screen ^E (^Et) | $USER@^EH"
windowlist title "Num Name%=Flags"

# Logging
# -------
bind L log                   # Toggle logging

# Synchronize Panes (Screen 4.2+)
# --------------------------------
# Screen doesn't have native synchronize-panes like tmux
# You can use "at" command to send to all windows
bind y command -c at         # Prepare for at commands
bind -c at "#" at "#" stuff "^M"  # Send to all windows

# Paste Buffer
# ------------
bind b paste .               # Paste buffer (tmux: paste-buffer)
bind P paste .               # Alternative paste
bind ] paste .               # Vi-style paste

# Zoom (maximize pane) - Screen 4.2+
# -----------------------------------
bind z only                  # Maximize current pane (tmux: zoom)
bind ^z only

# Remove Pane/Window
# ------------------
bind x remove                # Remove current pane (tmux: kill-pane)
bind ^x remove

# Command Prompt
# --------------
bind : colon                 # Command prompt (like tmux ;)
bind \; colon                # Alternative (matching tmux)

# Help
# ----
bind ? help                  # Show help

# Compatibility Notes
# ===================
# 1. Prefix: Screen uses C-a by default (tmux uses C-space in your config)
#    Screen cannot easily use C-space, so C-a is used here
# 2. Splits: Screen's split behavior differs slightly from tmux
# 3. Mouse: Screen has very limited mouse support compared to tmux
# 4. Plugins: Screen doesn't have a plugin manager like TPM
# 5. Pane swapping: Screen's "swap" is less flexible than tmux
# 6. Copy mode: Screen's copy mode is similar but not identical to tmux
# 7. Popup windows: Screen doesn't support popup windows (tmux display-popup)
# 8. True color: Screen's RGB support is limited compared to tmux

# Additional Useful Bindings
# --------------------------
bind w windowlist -b         # Window list (tmux-like)
bind s split                 # Alternative split
bind v split -v              # Alternative vertical split
bind o focus                 # Cycle through panes
bind ^o focus

# Clear screen
bind C-l eval "clear" "stuff ^L"

# Create initial windows (matching tmux new-session)
# --------------------------------------------------
# Uncomment to auto-create windows on startup
# screen -t shell1 1
# screen -t shell2 2
# select 1
