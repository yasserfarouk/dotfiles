#!/usr/bin/env bash
# Re-link everything: stow base/ and the platform folder (mac/ or linux/), sync folder shortcuts, set up fzf's
# shell integration. Safe to re-run; works with bash alone (zsh is optional).
# Usage: ./qupdate [--zsh | --bash | --shell=zsh|bash]
#   default: the shell recorded by quick-install.sh (~/.config/dotfiles-shell), else zsh if installed, else bash.
set -u
MYDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/dotfiles-shell.sh
source "$MYDIR/lib/dotfiles-shell.sh"

SHELL_MODE=
while [ $# -gt 0 ]; do
    case $1 in
        --shell) SHELL_MODE=${2:-}; shift; parse_shell_arg "--shell=$SHELL_MODE" ;;
        -h|--help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) parse_shell_arg "$1" || { echo "Unknown option: $1" >&2; exit 2; } ;;
    esac
    shift
done
case $SHELL_MODE in
    zsh|bash) DOTFILES_SHELL=$SHELL_MODE ;;
    *) DOTFILES_SHELL=$(saved_shell_choice) || { _have zsh && DOTFILES_SHELL=zsh || DOTFILES_SHELL=bash; } ;;
esac
if [ "$DOTFILES_SHELL" = zsh ] && ! _have zsh; then
    echo "ERROR: zsh is not installed; run ./quick-install.sh (installs it when root is available) or use --bash" >&2
    exit 1
fi
save_shell_choice
echo "Shell: $DOTFILES_SHELL"

export PATH="$HOME/.local/bin:$PATH"
for b in /opt/homebrew/bin/brew /usr/local/bin/brew "$HOME/.linuxbrew/bin/brew" /home/linuxbrew/.linuxbrew/bin/brew; do
    [ -x "$b" ] && { eval "$("$b" shellenv)"; break; }
done

# vim and neovim share ~/.local/share/nvim/site (~/.vimrc itself comes from the vim package)
mkdir -p "$HOME/.local/share/nvim/site"
# (a relative link: an absolute one makes stow 2.3 report "BUG in find_stowed_path")
[ "$(readlink "$HOME/.vim" 2>/dev/null)" = "$HOME/.local/share/nvim/site" ] && rm "$HOME/.vim"
[ -e "$HOME/.vim" ] || [ -L "$HOME/.vim" ] || ln -s .local/share/nvim/site "$HOME/.vim"
mkdir -p "$HOME/.vim/doc" 2>/dev/null || true

echo "Stowing all files"
echo "------------------"
stow_packages "$MYDIR/base"
case "$(uname -s)" in
    Darwin) stow_packages "$MYDIR/mac" ;;
    Linux)  stow_packages "$MYDIR/linux" ;;
esac
[ -x "$HOME/bin/shortcut" ] && "$HOME/bin/shortcut" sync  # folder shortcuts -> zoxide, sesh

# fzf key bindings/completion: brew's installer writes ~/.fzf.{bash,zsh}; without it the rc files fall back to
# `fzf --bash` / `fzf --zsh` (fzf >= 0.48)
if _have brew && [ -x "$(brew --prefix)/opt/fzf/install" ]; then
    "$(brew --prefix)/opt/fzf/install" --key-bindings --completion --no-update-rc >/dev/null || true
fi

echo "------------------------------------------------------------"
echo "Done. Open a new shell (or: exec $DOTFILES_SHELL -l) to load the configs."
